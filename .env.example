# PahaadSaathi Environment Configuration Template

# Supabase Cloud Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Valhalla Routing Engine API (Optional - defaults to public demo endpoint)
EXPO_PUBLIC_VALHALLA_URL=https://valhalla1.openstreetmap.de

# SMS Gateway Number (Optional fallback ingestion endpoint)
EXPO_PUBLIC_SMS_GATEWAY_NUMBER=+919411112973

# MQTT 5.0 Real-Time Event Backbone (EMQX Cloud / Serverless / TLS WSS)
# Default zero-cost test endpoint: wss://broker.emqx.io:8084/mqtt
EXPO_PUBLIC_MQTT_WS_URL=wss://broker.emqx.io:8084/mqtt
EXPO_PUBLIC_MQTT_BROKER_URL=broker.emqx.io
EXPO_PUBLIC_MQTT_PORT=8084
EXPO_PUBLIC_MQTT_ENVIRONMENT=development
EXPO_PUBLIC_MQTT_USERNAME=
EXPO_PUBLIC_MQTT_PASSWORD=
EXPO_PUBLIC_MQTT_CLIENT_ID_PREFIX=ps
EXPO_PUBLIC_MQTT_KEEP_ALIVE=30
EXPO_PUBLIC_MQTT_SESSION_EXPIRY=3600

# NVIDIA AI Hazard Image Verification (Backend / Supabase Edge Functions only - never prefix with EXPO_PUBLIC)
NVIDIA_API_KEY=your_nvidia_api_key_here
